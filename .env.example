# Docker Compose (optional root .env; defaults already match these values)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Backend: copy the lines below into backend/.env. Never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
